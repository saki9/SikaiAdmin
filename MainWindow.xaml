<Window x:Class="SikaiAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIKAI Admin"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GbaPageBg}">

    
    <Grid Width="560" Height="744">

        
        <Border Margin="40,31,42,375"
                Background="{StaticResource GbaScreenBg}"
                CornerRadius="22"/>

        
        <Image Source="pack://application:,,,/Assets/gba_shell.png"
               Stretch="Fill"
               IsHitTestVisible="False"/>

        
        <Grid Margin="43,34,45,378">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <DockPanel Grid.Row="0" Margin="18,14,18,0">
                <Button DockPanel.Dock="Right"
                        Content="SIGN OUT"
                        Width="92"
                        Height="28"
                        FontSize="11"
                        Style="{StaticResource GbaButtonOutline}"
                        Click="SignOut_Click"/>
                <TextBlock x:Name="WelcomeText"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="11"
                           Foreground="{StaticResource GbaInkMuted}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="26,0,26,8" VerticalAlignment="Center">
                <Button x:Name="Item1"
                        Style="{StaticResource GbaMenuItem}"
                        Click="CreateAccount_Click">
                    <TextBlock Text="1. Create new" TextWrapping="Wrap" FontSize="22"/>
                </Button>
                <TextBlock Text="    account"
                           FontFamily="{StaticResource PixelFont}"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{StaticResource GbaInk}"
                           Margin="2,-8,0,2"/>

                <Button x:Name="Item2"
                        Style="{StaticResource GbaMenuItem}"
                        Margin="0,4,0,0"
                        Click="CreateClass_Click" FontSize="22">
                    <TextBlock Text="2. Create new" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Text="    class"
                           FontFamily="{StaticResource PixelFont}"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{StaticResource GbaInk}"
                           Margin="2,-8,0,2"/>

                <Button x:Name="Item3"
                        Style="{StaticResource GbaMenuItem}"
                        Margin="0,4,0,0"
                        Click="RemoveAccount_Click" FontSize="22">
                    <TextBlock Text="3. Remove" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Text="    account"
                           FontFamily="{StaticResource PixelFont}"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{StaticResource GbaInk}"
                           Margin="2,-8,0,2"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
