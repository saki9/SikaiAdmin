<Window x:Class="SikaiAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIKAI Admin - Login"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GbaPageBg}">

    
    <Grid Width="560" Height="744">

        
        <Border Margin="40,31,42,375"
                Background="{StaticResource GbaScreenBg}"
                CornerRadius="22"/>

        
        <Image Source="pack://application:,,,/Assets/gba_shell.png"
               Stretch="Fill"
               IsHitTestVisible="False"/>

        
        <Grid Margin="43,34,45,378">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="240">
                <TextBlock Text="Login"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource PixelFont}"
                           FontWeight="Bold"
                           FontSize="48"
                           TextDecorations="Underline"
                           Foreground="{StaticResource GbaInk}"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Password:"
                           FontFamily="{StaticResource PixelFont}"
                           FontWeight="Bold"
                           FontSize="24"
                           Foreground="{StaticResource GbaInk}"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordBox1"
                             PasswordChar="-"
                             FontFamily="{StaticResource PixelFont}"
                             FontWeight="Bold"
                             FontSize="22"
                             Foreground="{StaticResource GbaInk}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             CaretBrush="{StaticResource GbaInk}"
                             KeyDown="PasswordBox1_KeyDown"/>

                
                <TextBlock x:Name="FormError"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource GbaErrorText}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
